<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <main>
        <a href="/new">Add user</a>

        <h1><%= title %></h1>

        <%- include('partials/search') %>

        <% if (locals.result.length > 0) { %>
            <ul>
                <% result.forEach(res => { %>
                    <li><%= res.username %></li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>No user found.</p>
        <% } %>
    </main>
</body>
</html>